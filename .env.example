# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Backend (AI) ───────────────────────────────────────────────
AI_API_BASE_URL=          # OpenAI-compatible API base URL (e.g. https://api.openai.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Aliyun OSS (Optional but recommended for file uploads) ──────
OSS_REGION=               # e.g. oss-cn-hangzhou
OSS_ENDPOINT=             # e.g. https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=               # Your bucket name
OSS_ACCESS_KEY_ID=        # Aliyun AccessKey ID
OSS_ACCESS_KEY_SECRET=    # Aliyun AccessKey Secret
